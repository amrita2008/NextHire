# MongoDB Connection string (standard format)
# If running via docker-compose, this is managed automatically inside the containers.
DATABASE_URL="mongodb://localhost:27017/nexthire?replicaSet=rs0"

# JWT Auth Secret key for signing session tokens
JWT_SECRET="your_jwt_signing_secret_key_here"

# Google Gemini Developer API Key (Obtain from Google AI Studio)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
